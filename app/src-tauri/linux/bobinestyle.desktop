# Named after the program: its windows carry that name as their Wayland
# app id (Tauri's enableGTKAppId is off), and KDE finds a window's launcher,
# hence its icon, by that name -- any other name shows a generic "W".
[Desktop Entry]
Type=Application
Name=Bobine Style
Comment=Give the French subtitles of MKV files one clean house style
Comment[fr]=Applique un style maison propre aux sous-titres français des MKV
Keywords=subtitles;style;ass;srt;mkv;fonts;
Keywords[fr]=sous-titres;style;ass;srt;mkv;polices;
Exec=bobinestyle
Icon=bobine-style
StartupWMClass=bobinestyle
Terminal=false
Categories=AudioVideo;Video;
