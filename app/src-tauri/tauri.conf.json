{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Style",
  "version": "0.1.0",
  "identifier": "com.bobinestyle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd ../engine && uv run python packaging/build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bobine Style",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/bobinestyle-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Applique le style maison aux sous-titres français des MKV",
    "publisher": "Marc Valat",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNUQ5Njg3Nzc0OTRDQTcKUldTblRFbDNoNVpkYjFSNlRITjVob2NvRkhydGJhMG02MWRBZTk1cmExcWRWdGppaHpzUEt4ajYK",
      "endpoints": [
        "https://github.com/MarcValat/BobineStyle/releases/latest/download/latest.json"
      ]
    }
  }
}
